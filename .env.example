# --- iPaymu Redirect Payment ---
# Sandbox: https://sandbox.ipaymu.com/api/v2
# Production: https://my.ipaymu.com/api/v2
IPAYMU_VA=ISI_VA_IPAYMU_DI_RAILWAY
IPAYMU_API_KEY=ISI_API_KEY_IPAYMU_DI_RAILWAY
IPAYMU_BASE_URL=https://sandbox.ipaymu.com/api/v2
IPAYMU_CALLBACK_URL=https://smarthomebogor-production.up.railway.app/api/webhook-ipaymu
IPAYMU_RETURN_URL=https://smarthomebogor.my.id/?payment=return
IPAYMU_CANCEL_URL=https://smarthomebogor.my.id/?payment=cancel

# WAJIB token LIVE untuk tarif ongkir aktual (bukan biteship_test)
BITESHIP_API_KEY=biteship_live.xxxx
ALLOWED_ORIGINS=https://smarthomebogor.my.id,https://www.smarthomebogor.my.id
DATA_DIR=/data
MIN_SUBTOTAL=100000
MAX_SUBTOTAL=200000000

# --- Tambahan ---
# Kode pos asal pengiriman (dipakai untuk tarif kurir Biteship)
ORIGIN_POSTAL_CODE=16100
# Token admin (minimal 16 karakter acak). Kosongkan untuk menonaktifkan endpoint /api/admin
ADMIN_TOKEN=
# Notifikasi pesanan ke Telegram pemilik (opsional). Buat bot lewat @BotFather, chat id lewat @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Berat awal paket komponen untuk cek tarif Biteship (ubah sesuai berat rata-rata paket setelah dikemas)
COMPONENT_DEFAULT_WEIGHT_GRAM=1000
