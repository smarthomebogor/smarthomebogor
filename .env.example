# --- DOKU Checkout (SANDBOX). Ambil dari DOKU Dashboard Sandbox > Integration > API Keys ---
DOKU_CLIENT_ID=BRN-xxxx-xxxxxxxxxxxxx
DOKU_SECRET_KEY=SK-xxxxxxxxxxxxxxxx
DOKU_BASE_URL=https://api-sandbox.doku.com
# Produksi: DOKU_BASE_URL=https://api.doku.com
DOKU_NOTIFY_URL=https://smarthomebogor-production.up.railway.app/api/webhook-doku
DOKU_CALLBACK_URL=https://smarthomebogor.my.id/?payment=return

BITESHIP_API_KEY=biteship_test_xxxx
ALLOWED_ORIGINS=https://smarthomebogor.my.id,https://www.smarthomebogor.my.id
DATA_DIR=/data
MIN_SUBTOTAL=100000
MAX_SUBTOTAL=200000000

# --- Tambahan ---
# Kode pos asal pengiriman (dipakai untuk tarif kurir Biteship)
ORIGIN_POSTAL_CODE=16100
# Token admin (minimal 16 karakter acak). Kosongkan untuk menonaktifkan endpoint /api/admin
ADMIN_TOKEN=
# Notifikasi pesanan ke Telegram pemilik (opsional). Buat bot lewat @BotFather, chat id lewat @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
